NODE_ENV=development
PORT=8084
# HTTP bind address. Use 0.0.0.0 (default) so phones on Wi‑Fi can call your LAN IP.
LISTEN_HOST=0.0.0.0

# PostgreSQL — local Homebrew (no Docker):
#   brew services start postgresql@15
#   npm run db:setup          # create role+db, migrate, seed
#   npm run db:create         # role + database only
#   npm run db:migrate        # prisma migrate dev
#   npm run db:migrate:deploy # apply committed migrations
#   npm run db:seed
#   npm run db:reset          # drop → create → migrate → seed
#   npm run db:drop
#   npm run db:studio
DATABASE_URL="postgresql://flight:flight@localhost:5432/flight_one?schema=public"
# Production: point app at PgBouncer (transaction mode), migrations at direct port:
# DATABASE_URL="postgresql://user:****@host:25061/defaultdb?sslmode=require"
# DATABASE_URL_DIRECT="postgresql://user:****@host:25060/defaultdb?sslmode=require"
# DATABASE_POOL_SIZE=8
# DATABASE_POOL_TIMEOUT=20

# Log requests slower than N ms (default 500)
# SLOW_REQUEST_MS=500

# JWT — access tokens are short-lived; HttpOnly refresh cookie + client AuthBootstrap /
# RTK 401 refresh re-issue. Do not use multi-hour access TTLs in production.
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# HttpOnly refresh cookie (fo_refresh). In production, Secure defaults on and
# SameSite defaults to None (cross-origin SPA). Override only if you know why.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# AUTH_RETURN_REFRESH_IN_BODY=false
# REFRESH_ROTATE_GRACE_MS=15000
# SHUTDOWN_TIMEOUT_MS=25000

# Password recovery (Module 00). Link base used in reset emails.
# PUBLIC_APP_URL=http://localhost:3000
# PASSWORD_RESET_EXPIRES_IN=1h
# Test-only: return raw token in forgot-password response (never enable in production).
# PASSWORD_RESET_RETURN_TOKEN=true

# Module 00 / 02 — field-level encryption for PII (passport, CNIC, visa numbers).
# 64 hex chars (32 bytes) preferred, or any secret (SHA-256 derived).
# FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Module 02 — document expiry notification lead days (PRD defaults: 180,30,7).
# PROFILE_DOC_EXPIRY_LEAD_DAYS=180,30,7
# PROFILE_DOC_NOTIFICATION_CHANNELS=APP,EMAIL,WHATSAPP
# Worker: npm run worker:profile-expiry  (also in ecosystem.config.cjs cron)

# Module 02 — OCR (no SDK in-repo). Default: unconfigured (empty fields, no fake data).
# OCR_PROVIDER=unconfigured
# OCR_PROVIDER=http
# OCR_HTTP_URL=https://your-ocr-service/v1/extract
# OCR_HTTP_API_KEY=
# OCR_HTTP_TIMEOUT_MS=15000
# OCR_HTTP_SEND_BINARY=true

# Module 08 — Visa Intelligence. Default catalog reads ops-attributed VisaRequirement rows.
# Never invent credentials or live Timatic rules. Explicit unconfigured disables lookups.
# VISA_PROVIDER=catalog
# VISA_PROVIDER=unconfigured
# VISA_PROVIDER=http
# VISA_HTTP_URL=https://your-visa-authority/v1/requirements
# VISA_HTTP_API_KEY=
# VISA_HTTP_TIMEOUT_MS=12000
# VISA_STALE_AFTER_DAYS=180
# Visa expiry / apply-by NotificationOutbox (never invent processing times or departAt).
# VISA_DOC_EXPIRY_LEAD_DAYS=180,30,7
# VISA_APPLY_BY_LEAD_DAYS=30,14,7
# VISA_NOTIFICATION_CHANNELS=APP,EMAIL,WHATSAPP
# Worker: npm run worker:visa-notifications  (also in ecosystem.config.cjs cron)

# Module 09 — Live Journey Management. Default: unconfigured (never fabricate status).
# JOURNEY_STATUS_PROVIDER=unconfigured
# JOURNEY_STATUS_PROVIDER=http
# JOURNEY_STATUS_HTTP_URL=https://your-flight-status-provider/v1/status
# JOURNEY_STATUS_HTTP_API_KEY=
# JOURNEY_STATUS_HTTP_TIMEOUT_MS=12000
# JOURNEY_STATUS_STALE_AFTER_MS=1800000
# JOURNEY_NOTIFICATION_CHANNELS=APP,EMAIL,WHATSAPP
# JOURNEY_BOARDING_LEAD_MINUTES=90
# JOURNEY_WORKER_CONCURRENCY=3
# JOURNEY_WORKER_LOOKAHEAD_MS=259200000
# JOURNEY_WORKER_LOOKBEHIND_MS=21600000
# JOURNEY_WORKER_COOLDOWN_MS=300000
# JOURNEY_WORKER_BATCH_SIZE=200
# Ancillary feeds (weather / hotel status / transfer / immigration) — fail-closed by default.
# JOURNEY_WEATHER_PROVIDER=unconfigured
# JOURNEY_WEATHER_PROVIDER=http
# JOURNEY_WEATHER_HTTP_URL=
# JOURNEY_HOTEL_STATUS_PROVIDER=unconfigured
# JOURNEY_HOTEL_STATUS_HTTP_URL=
# JOURNEY_TRANSFER_STATUS_PROVIDER=unconfigured
# JOURNEY_TRANSFER_STATUS_HTTP_URL=
# JOURNEY_IMMIGRATION_PROVIDER=unconfigured
# JOURNEY_IMMIGRATION_PROVIDER=knowledge
# JOURNEY_IMMIGRATION_PROVIDER=http
# JOURNEY_IMMIGRATION_HTTP_URL=
# JOURNEY_ANCILLARY_HTTP_API_KEY=
# JOURNEY_ANCILLARY_HTTP_TIMEOUT_MS=12000
# JOURNEY_ANCILLARY_STALE_AFTER_MS=21600000
# JOURNEY_HOTEL_CHECKIN_LEAD_HOURS=24
# JOURNEY_TRANSFER_LEAD_MINUTES=180
# Worker: npm run worker:journey  (also in ecosystem.config.cjs cron)

# Phase 3 — Voice AI. Web STT/TTS default to the browser (client mic / speechSynthesis).
# Phone-line stays unconfigured until real credentials exist — never fabricate live calls.
# VOICE_STT_PROVIDER=browser
# VOICE_TTS_PROVIDER=browser
# VOICE_STT_PROVIDER=http
# VOICE_STT_HTTP_URL=
# VOICE_STT_HTTP_API_KEY=
# VOICE_TTS_PROVIDER=http
# VOICE_TTS_HTTP_URL=
# VOICE_TTS_HTTP_API_KEY=
# VOICE_TELEPHONY_PROVIDER=unconfigured
# VOICE_TELEPHONY_PROVIDER=http
# VOICE_TELEPHONY_HTTP_URL=
# VOICE_TELEPHONY_API_KEY=

# Phase 3 — Predictive recommendations calendar (fail-closed). Never invent events.
# CALENDAR_PROVIDER=unconfigured
# CALENDAR_PROVIDER=http
# CALENDAR_HTTP_URL=
# CALENDAR_HTTP_API_KEY=

# Phase 3 — White-label corporate portals (fail-closed). Never mark DNS/SSO live without a provider.
# CORPORATE_DOMAIN_VERIFY_PROVIDER=unconfigured
# CORPORATE_DOMAIN_VERIFY_PROVIDER=http
# CORPORATE_DOMAIN_VERIFY_HTTP_URL=
# CORPORATE_DOMAIN_VERIFY_HTTP_API_KEY=
# CORPORATE_SSO_PROVIDER=unconfigured
# CORPORATE_SSO_PROVIDER=oidc
# CORPORATE_SSO_ISSUER=
# EXPENSE_OCR_PROVIDER=unconfigured
# EXPENSE_OCR_HTTP_URL=
# EXPENSE_OCR_HTTP_API_KEY=
# EXPENSE_FINANCE_EXPORT_PROVIDER=unconfigured
# EXPENSE_FINANCE_EXPORT_HTTP_URL=

# Module 12 — MICE transfer booking (fail-closed). Requirements always stored;
# CONFIRMED only when provider returns confirmationRef. Never invent inventory.
# MICE_TRANSFER_BOOK_PROVIDER=unconfigured
# MICE_TRANSFER_BOOK_PROVIDER=http
# MICE_TRANSFER_BOOK_HTTP_URL=
# MICE_TRANSFER_BOOK_HTTP_API_KEY=
# MICE_TRANSFER_BOOK_HTTP_TIMEOUT_MS=15000
# Live transfer status (optional) reuses JOURNEY_TRANSFER_STATUS_* above.

# Module 07 — Traveller Vault binary storage. Default: unconfigured (fail-closed).
# Never invent cloud credentials. Local provider is for development/tests only.
# VAULT_STORAGE_PROVIDER=unconfigured
# VAULT_STORAGE_PROVIDER=local
# VAULT_LOCAL_ROOT=./.vault-local
# Soft-deleted user docs older than N days may be hard-purged (platform tickets never).
# VAULT_RETENTION_DAYS=365
# VAULT_PURGE_LIMIT=100
# Worker: npm run worker:vault-retention
# Keep VAULT_LOCAL_ROOT outside the git tree or gitignored (see .gitignore).

# NotificationOutbox delivery (APP needs no credentials; EMAIL/WhatsApp need webhooks).
# Unconfigured channels are marked FAILED — never silently SENT.
# NOTIFY_EMAIL_WEBHOOK_URL=
# NOTIFY_WHATSAPP_WEBHOOK_URL=
# NOTIFY_WEBHOOK_API_KEY=
# NOTIFY_WEBHOOK_TIMEOUT_MS=10000
# NOTIFY_DRAIN_BATCH_SIZE=50
# Worker: npm run worker:notify-drain  (also in ecosystem.config.cjs cron)

# Bootstrap first admin (optional in development; REQUIRED non-example values in production seed).
# Production seed refuses admin@example.com / ChangeMe123! and similar placeholders.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Super Admin

# CORS (comma-separated). FlightOne Next.js client default (dev only):
# Production refuses localhost / * — set the real SPA origin(s).
CORS_ORIGIN=http://localhost:3000

# API rate limit (disabled when NODE_ENV is not production unless RATE_LIMIT_IN_DEV=true)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_MAX=2000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_IN_DEV=true

# Per-route rate limits (middlewares/rateLimit.js). Defaults shown.
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=40
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=120

# LOG_LEVEL=debug
# Log every Prisma query (and only queries slower than PRISMA_SLOW_MS, in ms, if set).
# PRISMA_QUERY_LOG=1
# PRISMA_SLOW_MS=200
# Log per-request timing at debug level (middlewares/requestTiming.js).
# REQUEST_TIMING_DEBUG=1

# Module 03 — Bookings: quote/hold TTLs (ms). Defaults shown.
# BOOKING_QUOTE_TTL_MS=900000
# BOOKING_RESERVE_HOLD_MS=1800000
# Dev/test only — allows reserve/ticket state transitions without a live supplier
# hold/ticket. Never set in production. Does not invent PNRs or ticket numbers.
# ALLOW_SIMULATED_BOOKING=true

# Module 03 — Payments (tokenized capture only). Unconfigured unless Stripe is set.
# Never send PAN/CVV. STRIPE_SECRET_KEY enables live Stripe PaymentIntents.
# STRIPE_SECRET_KEY=
# Dev/test only — simulated tokenized capture. Never set in production.
# ALLOW_SIMULATED_PAYMENT=true

# Module 03 — RateHawk / Emerging Travel (hotels). Unconfigured unless both set.
# Never invent confirmations. Live E2E is unverified without these credentials.
# Hotel search requires numeric regionId (query.regionId) — IATA cityCode alone is not a RateHawk region.
# RATEHAWK_KEY_ID=
# RATEHAWK_API_KEY=
# RATEHAWK_API_BASE=https://api.worldota.net
# RATEHAWK_TIMEOUT_MS=30000

# Shared supplier search timeout (ms) for stub / wrapper paths.
# SUPPLIER_TIMEOUT_MS=4000
# SUPPLIER_OFFER_SNAPSHOT_TTL_MS=720000
# Short-TTL + single-flight cache for CatalogSearch (collapses multi-city fan-out).
# SUPPLIER_SEARCH_CACHE_TTL_MS=8000
# SUPPLIER_SEARCH_MAX_CONCURRENCY=4
# In-memory TTL for Booking fulfillment rates attached to search offers (ms).
# SUPPLIER_RELIABILITY_CACHE_TTL_MS=60000
# Circuit breaker (consecutive failures → open window). Applies to search + AirPrice/book/ticket.
# Process-local only — each Node process / PM2 cluster worker has its own OPEN/CLOSED map.
# Cluster-wide coordination needs external shared state (e.g. Redis); not bundled here.
# SUPPLIER_CIRCUIT_FAIL_LIMIT=5
# SUPPLIER_CIRCUIT_OPEN_MS=30000
# RATEHAWK_PREBOOK_PRICE_INCREASE_PERCENT=0
# RATEHAWK_FINISH_POLL_MS=200

# Travelport TripServices Flights (Galileo adapter). Pre-prod when TRAVELPORT_ENV=pp.
# Never commit real values — put them in local .env only.
# TRAVELPORT_ENV=pp
# TRAVELPORT_USERNAME=
# TRAVELPORT_PASSWORD=
# TRAVELPORT_CLIENT_ID=
# TRAVELPORT_CLIENT_SECRET=
# TRAVELPORT_PCC=UM2_1G
# TRAVELPORT_ACCESS_GROUP=
# TRAVELPORT_CONTENT_SOURCE=GDS
# TRAVELPORT_TIMEOUT_MS=45000
# TRAVELPORT_MAX_OFFERS=12
# TRAVELPORT_CURRENCY=PKR
# TRAVELPORT_STAYS_ACCEPT_VERSION=12
# TRAVELPORT_STAYS_CONTENT_VERSION=12
# TRAVELPORT_STAYS_RADIUS_KM=25

# Module 10 — Rewards & Referrals (rates are configuration, not fixed PRD law).
# REWARD_EARN_POINTS_PER_HUNDRED_MINOR=1
# REWARD_REFERRAL_BONUS_POINTS=500
# REWARD_POINT_VALUE_MINOR=1
# REWARD_CREDIT_EXPIRY_DAYS=365
# REWARD_TIER_SILVER_AT=1000
# REWARD_TIER_GOLD_AT=5000
# REWARD_TIER_PLATINUM_AT=20000
# REWARD_NOTIFICATION_CHANNELS=APP
# Worker: npm run worker:rewards-expiry  (also in ecosystem.config.cjs cron)

# Module 15 — Operations Platform external adapters (all optional / fail-closed).
# Without these, adapters report UNCONFIGURED and never invent sync success.
# OPS_CRM_BASE_URL=
# OPS_CRM_API_KEY=
# OPS_CRM_EVENTS_PATH=/api/v1/flightone/events
# OPS_CRM_VERIFY=false
# OPS_MIDOFFICE_BASE_URL=
# OPS_MIDOFFICE_API_KEY=
# OPS_MIDOFFICE_EVENTS_PATH=/api/v1/events
# OPS_MIDOFFICE_VERIFY=false
# OPS_BACKOFFICE_BASE_URL=
# OPS_BACKOFFICE_API_KEY=
# OPS_BACKOFFICE_EVENTS_PATH=/api/v1/events
# OPS_BACKOFFICE_VERIFY=false
# OPS_ACCOUNTING_BASE_URL=
# OPS_ACCOUNTING_API_KEY=
# OPS_ACCOUNTING_EVENTS_PATH=/api/v1/journal
# OPS_ACCOUNTING_VERIFY=false
# Worker: npm run worker:ops-drain  (also in ecosystem.config.cjs cron */5)
# OPS_DRAIN_BATCH_SIZE=50
# OPS_OUTBOX_MAX_ATTEMPTS=8
# OPS_OUTBOX_STALE_MS=900000
# Commission only when explicitly configured (bps). Also PricingConfig key ops_commission_bps.
# OPS_COMMISSION_BPS=

# Shared key so Next.js guest chat can call POST /api/v1/suppliers/search
# without a user JWT. Header: X-Internal-Api-Key
# INTERNAL_API_KEY=
