{
  "name": "flight-one-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:create": "bash scripts/db-create.sh",
    "db:drop": "bash scripts/db-drop.sh",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "DEMO_SEED=true node prisma/seed-demo.js",
    "db:seed:demo:reset": "DEMO_SEED=true DEMO_RESET=true node prisma/seed-demo.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:generate && npm run db:create && prisma migrate deploy && npm run db:seed",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:generate && prisma migrate deploy && npm run db:seed",
    "db:verify-migrations": "bash scripts/verify-migrations.sh",
    "smoke:travelport": "node scripts/smoke-travelport-search.js",
    "smoke:travelport:stays": "node scripts/smoke-travelport-stays.js",
    "worker:journey": "node workers/journey-monitor.js",
    "worker:profile-expiry": "node workers/profile-document-expiry.js",
    "worker:notify-drain": "node workers/notification-outbox-drain.js",
    "worker:ops-drain": "node workers/ops-outbox-drain.js",
    "worker:vault-retention": "node workers/vault-retention.js",
    "worker:visa-notifications": "node workers/visa-notifications.js",
    "worker:rewards-expiry": "node workers/rewards-expiry.js",
    "test:escalations": "node --test --test-concurrency=1 modules/escalations/escalations.unit.test.js modules/escalations/escalations.routing.unit.test.js modules/escalations/escalations.integration.test.js",
    "test:journey": "node --test --test-concurrency=1 modules/journey/journey.unit.test.js modules/journey/journey.ancillary.unit.test.js modules/journey/journey.workerSelect.unit.test.js modules/journey/journey.integration.test.js modules/bookings/bookings.lifecycle.integration.test.js",
    "test:rewards": "node --test --test-concurrency=1 modules/rewards/rewards.integration.test.js",
    "test:groups": "node --test --test-concurrency=1 modules/groups/groups.integration.test.js modules/groups/groups.requests.integration.test.js",
    "test:mice": "node --test --test-concurrency=1 modules/mice/mice.transfer.unit.test.js modules/mice/mice.integration.test.js modules/mice/mice.enquiries.integration.test.js",
    "test:refunds": "node --test --test-concurrency=1 modules/refunds/refunds.unit.test.js modules/refunds/refunds.integration.test.js",
    "test": "node --test lib/fieldEncryption.test.js lib/jwt.unit.test.js lib/productionConfig.unit.test.js lib/notifications/*.test.js lib/permissions.service.unit.test.js modules/auth/auth.cookies.unit.test.js modules/profile/profile.unit.test.js modules/profile/profile.integration.test.js modules/profile/documentLifecycle.unit.test.js modules/profile/documentLifecycle.integration.test.js modules/profile/ocr/*.test.js modules/suppliers/travelport/*.test.js modules/suppliers/adapter.circuit.unit.test.js modules/suppliers/demoSnapshot.unit.test.js modules/suppliers/demoBooking.unit.test.js modules/corporate/demoBypass.unit.test.js modules/journey/journey.details.unit.test.js modules/recommendations/recommendations.unit.test.js modules/recommendations/learning.unit.test.js modules/uploads/uploads.service.unit.test.js",
    "test:recommendations": "node --test --test-concurrency=1 modules/recommendations/recommendations.unit.test.js modules/recommendations/learning.unit.test.js modules/recommendations/recommendations.predictive.unit.test.js modules/recommendations/recommendations.predictive.integration.test.js",
    "test:profile": "node --test lib/fieldEncryption.test.js lib/notifications/*.test.js modules/profile/profile.unit.test.js modules/profile/profile.integration.test.js modules/profile/documentLifecycle.unit.test.js modules/profile/documentLifecycle.integration.test.js modules/profile/ocr/*.test.js modules/profile/profileDedupe.unit.test.js modules/profile/profileDedupe.integration.test.js modules/profile/history.unit.test.js",
    "test:pricing": "node --test modules/pricing/pricing.service.unit.test.js",
    "test:bookings": "node --test --test-concurrency=1 modules/suppliers/supplierBooking.unit.test.js modules/suppliers/adapter.merge.unit.test.js modules/suppliers/adapter.circuit.unit.test.js modules/suppliers/ratehawk.booking.unit.test.js modules/pricing/pricing.service.unit.test.js modules/suppliers/suppliers.search.integration.test.js modules/suppliers/suppliers.http.integration.test.js modules/bookings/bookings.integration.test.js modules/bookings/bookings.http.integration.test.js modules/bookings/bookings.lifecycle.integration.test.js modules/payments/payments.provider.unit.test.js modules/payments/payments.reservation.integration.test.js",
    "test:corporate": "node --test --test-concurrency=1 modules/corporate/corporate.service.unit.test.js modules/corporate/corporate.carbon.unit.test.js modules/corporate/corporate.p303.integration.test.js modules/payments/payments.reservation.integration.test.js",
    "test:permissions": "node --test middlewares/permission.test.js lib/permissions.service.unit.test.js",
    "test:auth": "node --test --test-concurrency=1 modules/auth/auth.refresh.unit.test.js modules/auth/auth.passwordReset.integration.test.js modules/auth/auth.sessions.integration.test.js modules/auth/auth.audit.integration.test.js",
    "test:vault": "node --test --test-concurrency=1 modules/vault/vault.storage.unit.test.js modules/vault/vault.printables.unit.test.js modules/vault/vault.retention.unit.test.js modules/vault/vault.visaMeta.unit.test.js modules/vault/vault.integration.test.js modules/vault/vault.visa.integration.test.js",
    "test:visa": "node --test --test-concurrency=1 modules/visa/visa.notifications.unit.test.js modules/visa/visa.integration.test.js",
    "test:operations": "node --test --test-concurrency=1 modules/operations/operations.unit.test.js modules/operations/operations.customerUpsert.unit.test.js modules/operations/operations.integration.test.js modules/operations/operations.outbox.worker.integration.test.js",
    "test:knowledge": "node --test --test-concurrency=1 modules/knowledge/knowledge.unit.test.js modules/knowledge/knowledge.integration.test.js",
    "test:dashboard": "node --test --test-concurrency=1 modules/dashboard/dashboard.integration.test.js modules/dashboard/dashboard.advanced.math.unit.test.js modules/dashboard/dashboard.advanced.integration.test.js",
    "test:voice": "node --test --test-concurrency=1 modules/voice/voice.unit.test.js modules/voice/voice.integration.test.js",
    "test:concierge": "node --test --test-concurrency=1 modules/concierge/concierge.unit.test.js modules/concierge/concierge.integration.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "~4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.10.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.6.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js",
    "schema": "prisma"
  }
}
